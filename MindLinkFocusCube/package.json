{
  "name": "mindlink-focus-cube",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "python -m backend.focuscube.server --demo",
    "dev:backend:device": "python -m backend.focuscube.server",
    "dev:backend:device:strict": "python -m backend.focuscube.server --require-device",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "python -m pytest backend/tests -q -p no:cacheprovider && npm --prefix frontend test -- --run",
    "build": "npm --prefix frontend run build",
    "verify": "npm run test && npm run build && npm --prefix frontend run verify:canvas"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
