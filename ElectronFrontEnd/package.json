{
  "name": "electronfrontend",
  "version": "1.2.3",
  "description": "electron frontend for the Mindlink app",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mindspeller/MindLink-Releases.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"webpack --mode development --watch\" \"wait-on dist/bundle.js && cross-env NODE_ENV=development electron .\"",
    "build": "webpack --mode production",
    "package": "npm run build && npx electron-builder",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "author": "Mindspeller",
  "license": "ISC",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "electron-updater": "^6.3.9",
    "i18next": "^26.0.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.4",
    "react-router-dom": "^7.13.1",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "electron": "^40.7.0",
    "electron-builder": "^26.8.1",
    "electron-reload": "^2.0.0-alpha.1",
    "html-webpack-plugin": "^5.5.3",
    "style-loader": "^3.3.3",
    "wait-on": "^7.0.1",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.mindspeller.Mindlink",
    "productName": "Mindlink Analyzer",
    "forceCodeSigning": false,
    "publish": {
      "provider": "github",
      "owner": "Mindspeller",
      "repo": "MindLink-Releases",
      "releaseType": "release",
      "channel": "mindlink"
    },
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "allowToChangeInstallationDirectory": false
    },
    "extraResources": [
      {
        "from": "../newBackend/dist/MindlinkBackend",
        "to": "backend"
      },
      {
        "from": "icon.ico",
        "to": "icon.ico"
      }
    ],
    "files": [
      "dist/**",
      "main.js",
      "package.json"
    ]
  },
  "allowScripts": {
    "@serialport/bindings-cpp@12.0.1": true,
    "electron@40.10.6": true,
    "electron-winstaller@5.4.0": true
  }
}
